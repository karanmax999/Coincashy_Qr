# ==============================================================================
# COINCASHY EMAIL CONSOLE & CRM CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Admin Security (Protected /admin/* and /api/email/* via Edge Middleware)
# ------------------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_secure_password_in_production
UNSUBSCRIBE_SECRET=generate_a_random_32_byte_hex_string_for_hmac

# ------------------------------------------------------------------------------
# 2. Database: Turso SQLite via LibSQL (Serverless Edge Database)
# ------------------------------------------------------------------------------
# Production: libsql://coincashy-db-yourname.turso.io
# Local development fallback: file:local.db
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ------------------------------------------------------------------------------
# 3. Email Delivery: Resend (Sender on mail.coincashy.io)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Coincashy <updates@mail.coincashy.io>
RESEND_WEBHOOK_SECRET=whsec_your_resend_svix_webhook_secret_here
TEST_EMAIL=team@coincashy.io

# ------------------------------------------------------------------------------
# 4. CRM: HubSpot (Private App Token - Sales Hub Starter, na2 Region)
# ------------------------------------------------------------------------------
# Scopes required:
# - crm.objects.contacts.read
# - crm.objects.contacts.write
# - crm.lists.read
# - crm.schemas.contacts.read
# - crm.schemas.contacts.write (for console_email_suppressed custom property)
# - crm.objects.custom.read
# - crm.objects.custom.write (for engagement activity notes)
HUBSPOT_ACCESS_TOKEN=pat-na2-your_private_app_token_here
HUBSPOT_PORTAL_ID=247718972
HUBSPOT_FORM_ID=7106e4ce-0d13-4c1d-8958-77280cc48f9a
HUBSPOT_REGION=na2

# ------------------------------------------------------------------------------
# 5. AI Drafting: Claude in the loop (/api/email/draft)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here
# Model string must not be hardcoded in application code:
ANTHROPIC_MODEL=claude-sonnet-5-5

# ------------------------------------------------------------------------------
# 6. Queue Engine & Automation (/api/email/cron/process-queue)
# ------------------------------------------------------------------------------
# Bearer secret required for invoking the cron queue processor (via Vercel Cron)
CRON_SECRET=generate_a_secure_random_cron_secret_token
WARMUP_DAILY_CAP=100

# ------------------------------------------------------------------------------
# 7. Site URL (For Canonical links, One-Click Unsubscribe headers, etc.)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://coincashy.io

# ------------------------------------------------------------------------------
# 8. Compliance & Legal Disclosures (Mandatory Polish VASP / GDPR footer)
# NOTE: Replace placeholder values marked VERIFY_BEFORE_PROD before live launch!
# ------------------------------------------------------------------------------
COINCASHY_LEGAL_ENTITY_NAME=Coincashy Sp. z o.o.
COINCASHY_LEGAL_KRS=VERIFY_BEFORE_PROD
COINCASHY_LEGAL_NIP=VERIFY_BEFORE_PROD
COINCASHY_LEGAL_VASP_REG=VERIFY_BEFORE_PROD
COINCASHY_LEGAL_ADDRESS=Warsaw, Poland (VERIFY_BEFORE_PROD)
